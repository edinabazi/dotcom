{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edinabazi-datafast-proxy",
  "main": "workers/datafast-proxy.ts",
  "compatibility_date": "2026-05-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "edinabazi.com/*",
      "custom_domain": false
    },
    {
      "pattern": "www.edinabazi.com/*",
      "custom_domain": false
    }
  ]
}
