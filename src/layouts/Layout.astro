---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	shortDescription?: string;
	canonicalPath?: string;
	image?: string;
}

const {
	title = "Edin Abazi - Design Engineer, Founder & Product Builder",
	description = "Edin Abazi is a design engineer and founder building brands, websites, apps, and software with a strong point of view on taste, craft, and shipping.",
	shortDescription = "Design engineer, founder, and product builder working across design, code, branding, software, and open source.",
	canonicalPath = "/",
	image = "/og.jpg",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://edinabazi.com");
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Edin Abazi",
	url: canonicalUrl,
	jobTitle: "Design Engineer",
	description: shortDescription,
	sameAs: [
		"https://linkedin.com/in/edinabazi",
		"https://github.com/edinabazi",
	],
	knowsAbout: [
		"Design Engineering",
		"Product Design",
		"Web Development",
		"Branding",
		"Open Source Software",
		"User Interface Design",
		"Frontend Development",
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Edin Abazi" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Edin Abazi - Design Engineer, Founder & Product Builder"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<script
			type="application/ld+json"
			set:html={JSON.stringify(personSchema)}
		/>
		<script
			defer
			data-website-id="dfid_xfzlnqC3gBftSSeuTt5It"
			data-domain="edinabazi.com"
			src="/js/script.js"
		></script>
		<title>{title}</title>
		<Font cssVariable="--font-marund" preload />
	</head>
	<body class="font-sans">
		<slot />
	</body>
</html>
