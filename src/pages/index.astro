---
import FadeIn from "../components/FadeIn";
import Highlight from "../components/Highlight";
import ProjectCard from "../components/ProjectCard";
import SiteHeader from "../components/SiteHeader.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Layout from "../layouts/Layout.astro";

const projects = [
    {
        title: "Playhead",
        description: "A beautiful, waveform-based, local music player.",
        href: "https://playheadapp.com/",
        iconSrc: "/assets/playhead-icon.webp",
        coverSrc: "/assets/playhead-cover.webp",
        coverAlt: "Playhead app screenshot",
        projectType: "open_source",
    },
    {
        title: "Kompakt",
        description: "A beautiful, native media compression & conversion app.",
        href: "https://kompaktapp.com/",
        iconSrc: "/assets/kompakt-icon.webp",
        coverSrc: "/assets/kompakt-cover.webp",
        coverAlt: "Kompakt app screenshot",
        projectType: "open_source",
    },
];

const workProjects = [
    {
        title: "Raze",
        description: "A hyper-specialized full-stack brand and web studio.",
        href: "https://razegrowth.com/",
        iconSrc: "/assets/raze-icon.webp",
        coverSrc: "/assets/raze-cover.webp",
        coverAlt: "Raze website preview",
        projectType: "studio",
    },
];
---

<Layout
    title="Edin Abazi - Design Engineer, Founder & Product Builder"
    description="Edin Abazi is a design engineer and founder building brands, websites, apps, and software with a strong point of view on taste, craft, and shipping."
    shortDescription="Design engineer, founder, and product builder working across design, code, branding, software, and open source."
>
    <main class="min-h-screen bg-black px-6 py-8 sm:py-20 text-white sm:px-8">
        <div
            class="mx-auto flex w-full max-w-container flex-col gap-12 sm:gap-20"
        >
            <FadeIn client:load>
                <SiteHeader />
            </FadeIn>

            <FadeIn client:load delay={0.08} className="flex flex-col gap-6">
                <h1
                    class="text-4xl sm:text-[42px] leading-none sm:leading-[1.05] tracking-tighter text-white"
                >
                    I design and build how <br /> tech companies go to market
                </h1>

                <div
                    class="flex flex-col gap-5 text-lg leading-[1.45] tracking-[-0.04em] text-muted [&_a]:text-white [&_a]:hover:underline"
                >
                    <p class="text-balance">
                        I work across positioning, branding, design and GTM
                        engineering, taking ideas from an unclear business
                        problem to a polished, shipped system.
                    </p>
                    <p class="text-balance">
                        That might mean defining the product direction,
                        sharpening the offer, designing the interface, building
                        the website, creating an internal tool, automating a
                        workflow, or connecting the technical infrastructure
                        behind it all.
                    </p>
                    <p class="text-balance">
                        Over the past 12 years, I’ve helped build brands,
                        websites, products and growth systems for tech companies
                        like <a
                            href="https://upkeep.com"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="/assets/favicons/upkeep.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 -translate-y-px rounded-[2px] align-[-0.125em]"
                            />UpKeep</a
                        >, <a
                            href="https://emotive.io"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="/assets/favicons/emotive.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 -translate-y-px rounded-[2px] align-[-0.125em]"
                            />Emotive</a
                        >, <a
                            href="https://doctronic.ai"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="https://www.doctronic.ai/favicon.svg"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 -translate-y-px rounded-[2px] align-[-0.125em]"
                            />Doctronic</a
                        >, <a
                            href="https://animalz.co"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="https://www.animalz.co/favicon.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 -translate-y-px rounded-[2px] align-[-0.125em]"
                            />Animalz</a
                        >, and <a
                            href="https://growthx.ai"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="/assets/favicons/growthx.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 -translate-y-px rounded-[2px] align-[-0.125em]"
                            />GrowthX</a
                        >.
                    </p>
                    <p class="text-balance">
                        I've also worked on projects for companies such as&nbsp;
                        <a
                            href="https://webflow.com/"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="/assets/favicons/webflow.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 rounded-[2px] align-[-0.125em]"
                            />Webflow</a
                        >, <a
                            href="https://ramp.com/"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="/assets/favicons/ramp.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 rounded-[2px] align-[-0.125em]"
                            />Ramp</a
                        >, <a
                            href="https://surgehq.ai/"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="/assets/favicons/surge.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 rounded-[2px] align-[-0.125em]"
                            />Surge</a
                        >, <a
                            href="https://abnormal.ai/"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="/assets/favicons/abnormal.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 rounded-[2px] align-[-0.125em]"
                            />Abnormal</a
                        >, and <a
                            href="https://augmentcode.com"
                            target="_blank"
                            rel="nofollow"
                            class="whitespace-nowrap"
                            ><img
                                src="/assets/favicons/augment.png"
                                alt=""
                                aria-hidden="true"
                                class="ml-0.5 mr-1 inline-block size-4 rounded-[2px] align-[-0.125em]"
                            />Augment Code</a
                        >.
                    </p>
                </div>
            </FadeIn>

            <section class="flex flex-col gap-8">
                <FadeIn
                    client:load
                    delay={0.16}
                    className="flex flex-col gap-4"
                >
                    <h2
                        class="text-4xl sm:text-[42px] leading-none tracking-[-0.04em] text-white"
                    >
                        Studio work
                    </h2>
                    <div
                        class="flex flex-col gap-5 text-lg leading-[1.45] tracking-[-0.04em] text-muted"
                    >
                        <p class="text-balance">
                            I co-founded Raze to work closer to the full arc of
                            building: positioning, brand, website, product,
                            growth, and the engineering needed to make it all
                            real.
                        </p>
                    </div>
                </FadeIn>

                <div class="flex flex-col gap-8">
                    {
                        workProjects.map((project, index) => (
                            <ProjectCard
                                client:load
                                delay={0.24 + index * 0.08}
                                {...project}
                            />
                        ))
                    }
                </div>
            </section>

            <section class="flex flex-col gap-8">
                <FadeIn
                    client:load
                    delay={0.28}
                    className="flex flex-col gap-6"
                >
                    <h2
                        class="text-4xl sm:text-[42px] leading-none tracking-[-0.04em] text-white"
                    >
                        Open source work
                    </h2>
                    <div
                        class="flex flex-col gap-5 text-lg leading-[1.45] tracking-[-0.04em] text-muted"
                    >
                        <p class="text-balance">
                            Most of what I know came from the open source
                            community. <br class="hidden sm:inline" />I'm
                            forever grateful to the community, and this is my
                            way of giving back.
                        </p>
                        <p class="text-balance">
                            Every project listed here is fully branded,
                            designed, developed, and maintained solely by me.
                        </p>
                    </div>
                </FadeIn>

                <div class="flex flex-col gap-8">
                    {
                        projects.map((project, index) => (
                            <ProjectCard
                                client:load
                                delay={0.36 + index * 0.08}
                                {...project}
                            />
                        ))
                    }
                </div>
            </section>

            <section>
                <FadeIn
                    client:load
                    delay={0.48}
                    className="flex flex-col gap-4 py-24"
                >
                    <h2
                        class="text-4xl sm:text-[42px] leading-none tracking-[-0.04em] text-white"
                    >
                        Get in touch
                    </h2>
                    <p
                        class="text-lg leading-[1.45] tracking-[-0.04em] text-pretty"
                    >
                        If you’re working on something ambitious and think I
                        could help, <br /><a
                            href="mailto:hello@edinabazi.com"
                            class="text-white hover:underline"
                            >send me an email</a
                        >.
                    </p>
                </FadeIn>
            </section>

            <footer class="flex justify-center pb-8 sm:hidden">
                <SocialLinks location="footer" />
            </footer>
        </div>
    </main>
</Layout>
