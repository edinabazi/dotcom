---
import FadeIn from "../components/FadeIn";
import Highlight from "../components/Highlight";
import ProjectCard from "../components/ProjectCard";
import SiteHeader from "../components/SiteHeader.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Layout from "../layouts/Layout.astro";

const projects = [
    {
        title: "Playhead",
        description: "A beautiful, waveform-based, local music player.",
        href: "https://playheadapp.com/",
        iconSrc: "/assets/playhead-icon.png",
        coverSrc: "/assets/playhead-cover.png",
        coverAlt: "Playhead app screenshot",
    },
    {
        title: "Kompakt",
        description:
            "A beautiful, minimal native image & video compression app.",
        href: "https://kompaktapp.com/",
        iconSrc: "/assets/kompakt-icon.png",
        coverSrc: "/assets/kompakt-cover.png",
        coverAlt: "Kompakt app screenshot",
    },
];

const workProjects = [
    {
        title: "Raze",
        description: "A premium design and dev partner for startup founders.",
        href: "https://razegrowth.com/",
        iconSrc: "/assets/raze-icon.png",
        coverSrc: "/assets/raze-cover.png",
        coverAlt: "Raze website preview",
    },
];
---

<Layout
    title="Edin Abazi - Design Engineer, Founder & Product Builder"
    description="Edin Abazi is a design engineer and founder building brands, websites, apps, and software with a strong point of view on taste, craft, and shipping."
    shortDescription="Design engineer, founder, and product builder working across design, code, branding, software, and open source."
>
    <main class="min-h-screen bg-black px-6 py-8 sm:py-20 text-white sm:px-8">
        <div
            class="mx-auto flex w-full max-w-container flex-col gap-12 sm:gap-20"
        >
            <FadeIn client:load>
                <SiteHeader />
            </FadeIn>

            <FadeIn client:load delay={0.08} className="flex flex-col gap-8">
                <h1
                    class="text-4xl sm:text-5xl leading-none sm:leading-[0.96] tracking-tighter text-white"
                >
                    Taste matters,<br />now more than ever.
                </h1>

                <div
                    class="flex flex-col gap-5 text-lg leading-[1.45] tracking-[-0.04em] text-muted"
                >
                    <p>
                        “Design engineer” is the closest label for what I do,
                        but it feels too narrow.
                    </p>
                    <p>
                        I sit somewhere between design, code, product, and most
                        importantly <Highlight client:load delay={1.2}
                            >taste</Highlight
                        >. <br class="hidden sm:inline" />I care deeply about
                        how software looks, feels, behaves, performs, and ships.
                    </p>
                    <p>
                        I get involved early: from the tech stack and product
                        direction, to every pixel, interaction, animation,
                        deployment, and tiny detail that makes the whole thing
                        feel right.
                    </p>
                    <p>
                        Over the past 12+ years, I’ve helped create brands,
                        websites, apps, tools, and systems across more
                        industries than I can count.
                    </p>
                    <p>
                        I <Highlight client:load delay={2.5}>love</Highlight> this
                        shit, and I want more.
                    </p>
                </div>
            </FadeIn>

            <section class="flex flex-col gap-8">
                <FadeIn
                    client:load
                    delay={0.16}
                    className="flex flex-col gap-8"
                >
                    <h2
                        class="text-4xl sm:text-5xl leading-none tracking-[-0.04em] text-white"
                    >
                        Studio work
                    </h2>
                    <div
                        class="flex flex-col gap-5 text-lg leading-[1.45] tracking-[-0.04em] text-muted"
                    >
                        <p>
                            I co-founded Raze to work closer to the full arc of
                            building: positioning, brand, website, product,
                            growth, and the engineering needed to make it all
                            real.
                        </p>
                    </div>
                </FadeIn>

                <div class="flex flex-col gap-8">
                    {
                        workProjects.map((project, index) => (
                            <ProjectCard
                                client:load
                                delay={0.24 + index * 0.08}
                                {...project}
                            />
                        ))
                    }
                </div>
            </section>

            <section class="flex flex-col gap-8">
                <FadeIn
                    client:load
                    delay={0.28}
                    className="flex flex-col gap-8"
                >
                    <h2
                        class="text-4xl sm:text-5xl leading-none tracking-[-0.04em] text-white"
                    >
                        Open source work
                    </h2>
                    <div
                        class="flex flex-col gap-5 text-lg leading-[1.45] tracking-[-0.04em] text-muted"
                    >
                        <p>
                            Most of what I know came from the open source
                            community. <br class="hidden sm:inline" />I'm
                            forever grateful to the community, and this is my
                            way of giving back.
                        </p>
                        <p>
                            Every project listed here is fully branded,
                            designed, developed, and maintained solely by me.
                        </p>
                    </div>
                </FadeIn>

                <div class="flex flex-col gap-8">
                    {
                        projects.map((project, index) => (
                            <ProjectCard
                                client:load
                                delay={0.36 + index * 0.08}
                                {...project}
                            />
                        ))
                    }
                </div>
            </section>

            <footer class="flex justify-center pb-8 sm:hidden">
                <SocialLinks />
            </footer>
        </div>
    </main>
</Layout>
