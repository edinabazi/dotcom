---
import AsciiShaderPlayground from "../components/AsciiShaderPlayground";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="ASCII Shader Lab | Edin Abazi"
	description="Interactive ASCII shader playground for exploring reusable visual presets."
>
	<AsciiShaderPlayground client:load />
</Layout>

<script>
	import { trackEvent } from "../lib/analytics";

	trackEvent("shader_opened", {
		source: document.referrer || "direct",
	});
</script>
