---
import { AtSign } from "@lucide/astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import LastFmIcon from "./icons/LastFmIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";

interface Props {
    class?: string;
    location?: "header" | "footer";
}

const className = Astro.props.class ?? "";
const location = Astro.props.location ?? "header";
---

<nav aria-label="Social links" class={`flex items-center gap-6 ${className}`}>
    <a
        href="https://linkedin.com/in/edinabazi"
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"
        class="text-white transition-opacity hover:opacity-70"
        data-track-social-link
        data-platform="linkedin"
        data-location={location}
    >
        <LinkedInIcon class="fill-current" />
    </a>
    <a
        href="https://github.com/edinabazi"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
        class="text-white transition-opacity hover:opacity-70"
        data-track-social-link
        data-platform="github"
        data-location={location}
    >
        <GitHubIcon class="fill-current" />
    </a>
    <a
        href="mailto:hello@edinabazi.com"
        aria-label="Email"
        class="text-white transition-opacity hover:opacity-70"
        data-track-social-link
        data-track-email-link
        data-platform="email"
        data-location={location}
    >
        <AtSign size={20} strokeWidth={2.5} aria-hidden="true" />
    </a>
    <a
        href="https://www.last.fm/user/edinabazi"
        target="_blank"
        rel="noreferrer"
        aria-label="Last.fm"
        class="text-white transition-opacity hover:opacity-70"
        data-track-social-link
        data-platform="lastfm"
        data-location={location}
    >
        <LastFmIcon class="fill-current" />
    </a>
</nav>

<script>
    import { trackEvent } from "../lib/analytics";

    document.querySelectorAll("[data-track-social-link]").forEach((link) => {
        link.addEventListener("click", () => {
            if (!(link instanceof HTMLElement)) return;

            const platform = link.dataset.platform;
            const location = link.dataset.location;

            trackEvent("social_link_clicked", {
                platform,
                location,
            });

            if (link.hasAttribute("data-track-email-link")) {
                trackEvent("email_clicked", {
                    location,
                });
            }
        });
    });
</script>
