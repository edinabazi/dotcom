---
import SocialLinks from "./SocialLinks.astro";
---

<header
    class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center sm:gap-4"
>
    <div class="flex min-w-0 flex-1 items-center gap-4">
        <img
            src="/assets/avatar.jpg"
            alt="Edin Abazi"
            class="squircle size-16 shrink-0 rounded-2xl sm:rounded-avatar object-cover"
        />
        <div class="flex min-w-0 flex-col gap-0">
            <p class="text-2xl tracking-[-0.04em] text-white">Edin Abazi</p>
            <p
                class="-mt-0.5 text-base leading-tight tracking-[-0.04em] text-muted"
            >
                Design engineer, founder & all-arounder
            </p>
        </div>
    </div>

    <SocialLinks class="hidden sm:flex" />
</header>
